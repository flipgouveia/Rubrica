# Node
node_modules/
dist/
dist-ssr/
*.local

# Vite
.vite/

# Rust / Tauri
src-tauri/target/
src-tauri/Cargo.lock.bak
# Auto-(re)generated by tauri-build on every build for capabilities-file
# editor tooling — not source, don't diff/review it.
src-tauri/gen/schemas/

# Generated bindings (checked in, but ignore drift scratch)
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code local session state (launch.json is the one file worth sharing)
.claude/*
!.claude/launch.json

# OS
Thumbs.db
.DS_Store

# Fixtures build scratch
fixtures/.generated/

# e2e suite's own scratch output (saved PDFs from mutating specs — see e2e/lib/actions.mjs's
# saveAs helper; specs must never Ctrl+S over a checked-in fixtures/*.pdf directly)
e2e/.scratch/

# Env
.env
.env.local

# Updater signing keypair (R7) — the PRIVATE half must never be committed.
# Generated locally via `pnpm tauri signer generate`; the public half's
# content (not this file) is embedded in tauri.conf.json. See
# docs/INSTALL.md for how CI gets the private key (a GitHub Actions secret,
# never a file in the repo).
.secrets/
